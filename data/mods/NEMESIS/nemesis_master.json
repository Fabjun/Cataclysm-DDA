  {
    "type": "effect_on_condition",
    "id": "EOC_NEMESIS_TRACKER",
    "eoc_type": "RECURRING",
    "global": true,
    "run_for_npcs": true,
    "recurrence": [
      "60 minutes",
      "60 minutes"
    ],
    "condition": {
      "u_has_trait": "NEMESIS_MARK"
    },
    "effect": [
      {
        "if": {
          "u_has_effect": "NEMESIS_AMBUSH"
        },
        "then": [
          {
            "math": [
              "global_nemtrack_omt_dist = abs(u_val('pos_x') / 24 - global_player_omt_x) + abs(u_val('pos_y') / 24 - global_player_omt_y)"
            ]
          },
          {
            "if": {
              "math": [
                "global_nemtrack_omt_dist <= 5"
              ]
            },
            "then": [
              {
                "u_lose_effect": "NEMESIS_AMBUSH"
              },
              {
                "location_variable_adjust": {
                  "global_val": "global_nemesis_player_ms_pos"
                },
                "output_var": {
                  "u_val": "nemesis_last_tracked_pos"
                }
              },
              {
                "u_add_effect": "NEMESIS_HUNTING",
                "duration": "PERMANENT"
              },
              {
                "u_add_effect": "NEMESIS_OVR_DIST",
                "duration": "PERMANENT",
                "intensity": 30
              },
              {
                "u_lose_effect": "NEMESIS_FRUSTRATION"
              },
              {
                "math": [
                  "global_nemtrack_resume_pending = global_nemtrack_resume_pending + 1"
                ]
              }
            ]
          }
        ]
      },
      {
        "if": {
          "u_has_effect": "NEMESIS_HUNTING"
        },
        "then": [
          {
            "math": [
              "global_nemtrack_omt_dist = abs(u_val('pos_x') / 24 - global_player_omt_x) + abs(u_val('pos_y') / 24 - global_player_omt_y)"
            ]
          },
          {
            "math": [
              "global_nemtrack_score = max(0, u_val('perception') - global_nemtrack_omt_dist * 3) * 10"
            ]
          },
          {
            "if": {
              "and": [
                {
                  "math": [
                    "global_nemesis_noise_level > 0"
                  ]
                },
                {
                  "not": {
                    "u_has_flag": "DEAF"
                  }
                }
              ]
            },
            "then": [
              {
                "math": [
                  "global_nemtrack_score = global_nemtrack_score + global_nemesis_noise_level * 2"
                ]
              }
            ]
          },
          {
            "if": {
              "or": [
                {
                  "and": [
                    {
                      "math": [
                        "global_nemtrack_omt_dist <= 2"
                      ]
                    },
                    {
                      "math": [
                        "global_nemtrack_score > 0"
                      ]
                    }
                  ]
                },
                {
                  "math": [
                    "global_nemtrack_score >= 15"
                  ]
                }
              ]
            },
            "then": [
              {
                "location_variable_adjust": {
                  "global_val": "global_nemesis_player_ms_pos"
                },
                "output_var": {
                  "u_val": "nemesis_last_tracked_pos"
                }
              },
              {
                "u_set_goal": {
                  "om_terrain": "field",
                  "var": {
                    "u_val": "nemesis_last_tracked_pos"
                  }
                }
              },
              {
                "u_add_effect": "NEMESIS_OVR_DIST",
                "duration": "PERMANENT",
                "intensity": {
                  "math": [
                    "max(2, u_effect_intensity('NEMESIS_OVR_DIST') - 3)"
                  ]
                }
              },
              {
                "u_add_effect": "NEMESIS_FRUSTRATION",
                "duration": "PERMANENT",
                "intensity": {
                  "math": [
                    "max(0, u_effect_intensity('NEMESIS_FRUSTRATION') - 2)"
                  ]
                }
              },
              {
                "math": [
                  "global_nemtrack_msg_pending = global_nemtrack_msg_pending + 1"
                ]
              }
            ],
            "else": [
              {
                "if": {
                  "math": [
                    "global_player_in_safe_zone == 1"
                  ]
                },
                "then": [
                  {
                    "u_lose_effect": "NEMESIS_HUNTING"
                  },
                  {
                    "u_lose_effect": "NEMESIS_FRUSTRATION"
                  },
                  {
                    "u_add_effect": "NEMESIS_AMBUSH",
                    "duration": "PERMANENT",
                    "intensity": 1
                  },
                  {
                    "u_add_effect": "NEMESIS_OVR_DIST",
                    "duration": "PERMANENT",
                    "intensity": 5
                  },
                  {
                    "math": [
                      "global_nemtrack_ambush_pending = global_nemtrack_ambush_pending + 1"
                    ]
                  }
                ],
                "else": [
                  {
                    "if": {
                      "math": [
                        "u_effect_intensity('NEMESIS_FRUSTRATION') * 2 < u_val('intelligence') + u_val('perception')"
                      ]
                    },
                    "then": [
                      {
                        "u_add_effect": "NEMESIS_FRUSTRATION",
                        "duration": "PERMANENT",
                        "intensity": {
                          "math": [
                            "max(u_effect_intensity('NEMESIS_FRUSTRATION'), 0) + 1"
                          ]
                        }
                      },
                      {
                        "if": {
                          "math": [
                            "u_effect_intensity('NEMESIS_FRUSTRATION') * 4 < u_val('intelligence') + u_val('perception')"
                          ]
                        },
                        "then": [
                          {
                            "location_variable_adjust": {
                              "u_val": "nemesis_last_tracked_pos"
                            },
                            "output_var": {
                              "u_val": "nemesis_wander_target"
                            },
                            "overmap_tile": true,
                            "x_adjust": {
                              "math": [
                                "rng(-(max(2, u_effect_intensity('NEMESIS_OVR_DIST'))), max(2, u_effect_intensity('NEMESIS_OVR_DIST')))"
                              ]
                            },
                            "y_adjust": {
                              "math": [
                                "rng(-(max(2, u_effect_intensity('NEMESIS_OVR_DIST'))), max(2, u_effect_intensity('NEMESIS_OVR_DIST')))"
                              ]
                            }
                          },
                          {
                            "u_set_goal": {
                              "om_terrain": "field",
                              "var": {
                                "u_val": "nemesis_wander_target"
                              }
                            }
                          }
                        ],
                        "else": [
                          {
                            "if": {
                              "math": [
                                "u_effect_intensity('NEMESIS_FRUSTRATION') * 4 < u_val('intelligence') + u_val('perception') + 1"
                              ]
                            },
                            "then": [
                              {
                                "math": [
                                  "global_nemtrack_phase_shift_pending = global_nemtrack_phase_shift_pending + 1"
                                ]
                              }
                            ]
                          },
                          {
                            "u_location_variable": {
                              "u_val": "nemesis_self_pos"
                            },
                            "min_radius": 0,
                            "max_radius": 0
                          },
                          {
                            "location_variable_adjust": {
                              "u_val": "nemesis_self_pos"
                            },
                            "output_var": {
                              "u_val": "nemesis_wander_target"
                            },
                            "overmap_tile": true,
                            "x_adjust": {
                              "math": [
                                "rng(-(max(2, u_effect_intensity('NEMESIS_OVR_DIST'))), max(2, u_effect_intensity('NEMESIS_OVR_DIST')))"
                              ]
                            },
                            "y_adjust": {
                              "math": [
                                "rng(-(max(2, u_effect_intensity('NEMESIS_OVR_DIST'))), max(2, u_effect_intensity('NEMESIS_OVR_DIST')))"
                              ]
                            }
                          },
                          {
                            "u_set_goal": {
                              "om_terrain": "field",
                              "var": {
                                "u_val": "nemesis_wander_target"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "math": [
                          "global_nemesis_dread_range = max(3, (u_val('intelligence') + u_val('perception')) / 4)"
                        ]
                      },
                      {
                        "if": {
                          "math": [
                            "global_nemtrack_omt_dist <= global_nemesis_dread_range"
                          ]
                        },
                        "then": [
                          {
                            "math": [
                              "global_nemesis_close = 1"
                            ]
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "u_lose_effect": "NEMESIS_HUNTING"
                      },
                      {
                        "u_lose_effect": "NEMESIS_FRUSTRATION"
                      },
                      {
                        "u_add_effect": "NEMESIS_AMBUSH",
                        "duration": "PERMANENT",
                        "intensity": 1
                      },
                      {
                        "u_add_effect": "NEMESIS_OVR_DIST",
                        "duration": "PERMANENT",
                        "intensity": 5
                      },
                      {
                        "math": [
                          "global_nemtrack_ambush_pending = global_nemtrack_ambush_pending + 1"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "false_effect": [
      {
        "if": "u_is_avatar",
        "then": [
          {
            "u_location_variable": {
              "global_val": "global_nemesis_player_ms_pos"
            },
            "min_radius": 0,
            "max_radius": 0
          },
          {
            "math": [
              "global_player_omt_x = u_val('pos_x') / 24"
            ]
          },
          {
            "math": [
              "global_player_omt_y = u_val('pos_y') / 24"
            ]
          },
          {
            "if": {
              "math": [
                "global_nemesis_noise_level > 0"
              ]
            },
            "then": [
              {
                "math": [
                  "global_nemesis_noise_level = max(0, global_nemesis_noise_level - 5)"
                ]
              }
            ]
          },
          {
            "if": {
              "or": [
                {
                  "u_near_om_location": "shelter",
                  "range": 0
                },
                {
                  "u_near_om_location": "evac_center_13",
                  "range": 2
                },
                {
                  "u_near_om_location": "outpost",
                  "range": 0
                },
                {
                  "u_near_om_location": "ranch_camp_1",
                  "range": 12
                }
              ]
            },
            "then": [
              {
                "math": [
                  "global_player_in_safe_zone = 1"
                ]
              }
            ],
            "else": [
              {
                "math": [
                  "global_player_in_safe_zone = 0"
                ]
              }
            ]
          },
          {
            "if": {
              "math": [
                "global_nemesis_close == 1"
              ]
            },
            "then": [
              {
                "math": [
                  "global_nemesis_close = 0"
                ]
              },
              {
                "math": [
                  "global_nemesis_dread_score = u_val('perception') + u_skill('survival') * 2"
                ]
              },
              {
                "if": {
                  "math": [
                    "u_val('morale') > 0"
                  ]
                },
                "then": [
                  {
                    "math": [
                      "global_nemesis_dread_score = global_nemesis_dread_score + 2"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "math": [
                    "global_nemesis_dread_score >= 15"
                  ]
                },
                "then": [
                  {
                    "math": [
                      "global_nemtrack_dread_high_pending = global_nemtrack_dread_high_pending + 1"
                    ]
                  }
                ],
                "else": [
                  {
                    "if": {
                      "math": [
                        "global_nemesis_dread_score >= 12"
                      ]
                    },
                    "then": [
                      {
                        "math": [
                          "global_nemtrack_dread_mid_pending = global_nemtrack_dread_mid_pending + 1"
                        ]
                      }
                    ],
                    "else": [
                      {
                        "if": {
                          "math": [
                            "global_nemesis_dread_score >= 9"
                          ]
                        },
                        "then": [
                          {
                            "math": [
                              "global_nemtrack_dread_low_pending = global_nemtrack_dread_low_pending + 1"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
